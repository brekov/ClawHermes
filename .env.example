# ============================================================
# ClawHermes · 环境变量配置 (.env)
# ============================================================
# 复制为 .env 后填入真实值
# 非敏感操作配置请放在 channels/<name>.yaml 中（通过 ${VAR} 引用）
# 详见 docs/env-reference.md
# ============================================================

# ══════════════════════════════════════════
# LLM 提供商（至少配一个）
# ══════════════════════════════════════════

# DeepSeek（推荐默认）
DEEPSEEK_API_KEY=sk-xxx

# OpenAI
# OPENAI_API_KEY=sk-xxx

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini
# GOOGLE_API_KEY=xxx

# Groq
# GROQ_API_KEY=xxx

# Together AI
# TOGETHERAI_API_KEY=xxx

# Fireworks AI
# FIREWORKS_API_KEY=xxx

# Mistral
# MISTRAL_API_KEY=xxx

# Cohere
# COHERE_API_KEY=xxx

# xAI / Grok
# XAI_API_KEY=xxx

# OpenRouter
# OPENROUTER_API_KEY=xxx

# Ollama（本地, 无需 Key）
# OLLAMA_BASE_URL=http://localhost:11434

# vLLM（自部署）
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=xxx

# 自定义 litellm 端点
# CUSTOM_LLM_BASE_URL=https://your-api.com/v1
# CUSTOM_LLM_API_KEY=xxx

# ══════════════════════════════════════════
# 模型选择
# ══════════════════════════════════════════

# CH_DEFAULT_MODEL=deepseek/deepseek-chat

# ══════════════════════════════════════════
# Gateway 服务
# ══════════════════════════════════════════

# CH_GATEWAY_HOST=127.0.0.1
# CH_GATEWAY_PORT=18789
# CH_GATEWAY_SECRET=          # 非 127.0.0.1 监听时必须设置
# CH_TOOLS_PROFILE=standard   # minimal | standard | full

# ══════════════════════════════════════════
# 存储
# ══════════════════════════════════════════

# CH_DATA_DIR=~/.clawhermes   # 数据目录

# ══════════════════════════════════════════
# 飞书渠道 (Feishu / Lark)
# 需要: pip install -e ./clawhermes-lark
# ══════════════════════════════════════════

# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_VERIFY_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_DOMAIN=feishu        # feishu | lark
# FEISHU_GROUP_POLICY=allowlist  # allowlist | open | disabled

# ══════════════════════════════════════════
# 微信渠道 (WeChat)
# 需要: pip install -e ./clawhermes-weixin
# ══════════════════════════════════════════

# WECHAT_APP_ID=xxx
# WECHAT_APP_SECRET=xxx
# WECHAT_TOKEN=xxx
# WECHAT_ENCODING_AES_KEY=xxx

# ══════════════════════════════════════════
# QQ 渠道
# 需要: pip install -e ./clawhermes-qq
# ══════════════════════════════════════════

# QQ_APP_ID=xxx
# QQ_TOKEN=xxx
# QQ_SECRET=xxx

# ══════════════════════════════════════════
# DM 配对
# ══════════════════════════════════════════

# ADMIN_KEY=xxx                # 管理员密钥（用于 DM 配对管理）

# ══════════════════════════════════════════
# 搜索工具
# ══════════════════════════════════════════

# CH_SEARCH_ENGINE=duckduckgo  # duckduckgo | searxng | serpapi | tavily
# CH_SEARXNG_URL=http://localhost:8888
# CH_SERPAPI_KEY=xxx
# CH_TAVILY_KEY=xxx
