# ========================
# ClawHermes 环境变量配置
# ========================
# 复制此文件为 .env 后填入真实值
# 完整说明见 docs/env-reference.md

# === LLM Providers（选一个即可）===
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CH_DEFAULT_MODEL=deepseek/deepseek-chat

# === Gateway ===
# CH_GATEWAY_HOST=127.0.0.1
# CH_GATEWAY_PORT=18789
# 绑定非 127.0.0.1 时必须设置
# CH_GATEWAY_SECRET=

# === 消息渠道（通过 gateway setup 交互式配置）===
# 运行 clawhermes gateway setup 按提示配置
# 配置保存在 ~/.clawhermes/channels/ 目录

# === 存储 ===
# CH_DATA_DIR=~/.clawhermes

# (Channel Bridge 已不再需要，所有功能由 Python 原生实现)
