# ========================
# ClawHermes 环境变量配置
# ========================
# 复制此文件为 .env 后填入真实值
# 完整说明见 docs/env-reference.md

# === LLM Providers（选一个即可）===
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CH_DEFAULT_MODEL=deepseek/deepseek-chat

# === Gateway ===
# CH_GATEWAY_HOST=127.0.0.1
# CH_GATEWAY_PORT=18789
# 绑定非 127.0.0.1 时必须设置
# CH_GATEWAY_SECRET=

# === 消息渠道（声明式，启动自动连接）===
# 飞书
# CH_CHANNEL_FEISHU_ENABLED=true
# CH_CHANNEL_FEISHU_APP_ID=cli_xxx
# CH_CHANNEL_FEISHU_APP_SECRET=xxx

# 企业微信
# CH_CHANNEL_WECHAT_ENABLED=true
# CH_CHANNEL_WECHAT_CORP_ID=wwxxx
# CH_CHANNEL_WECHAT_CORP_SECRET=xxx
# CH_CHANNEL_WECHAT_AGENT_ID=1000001

# QQ
# CH_CHANNEL_QQ_ENABLED=true
# CH_CHANNEL_QQ_WS_URL=ws://127.0.0.1:6700

# Telegram
# CH_CHANNEL_TELEGRAM_ENABLED=true
# CH_CHANNEL_TELEGRAM_TOKEN=xxx:xxx

# === 存储 ===
# CH_DATA_DIR=~/.clawhermes

# === Channel Bridge ===
# CH_BRIDGE_PORT=18788
# CH_GATEWAY_URL=http://127.0.0.1:18789
