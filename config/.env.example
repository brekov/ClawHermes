# ========================
# ClawHermes 环境变量配置
# ========================
# 复制此文件为 .env 后填入真实值
# 完整说明见 docs/env-reference.md

# === LLM Providers（选一个即可）===
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CH_DEFAULT_MODEL=deepseek/deepseek-chat

# === Gateway ===
# CH_GATEWAY_HOST=127.0.0.1
# CH_GATEWAY_PORT=18789
# 绑定非 127.0.0.1 时必须设置
# CH_GATEWAY_SECRET=

# === Gateway 自动初始化（启动时自动创建 Agent）===
# CH_GW_API_KEY=
# CH_GW_MODEL=deepseek/deepseek-chat
# CH_TOOLS_PROFILE=standard

# === 存储 ===
# CH_DATA_DIR=~/.clawhermes
