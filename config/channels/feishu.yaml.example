# ============================================
# 消息渠道配置示例 — 飞书
# ============================================
# 保存位置：~/.clawhermes/channels/feishu.yaml
# 适配器类：ChannelAdapter(channel_type=ChannelType.FEISHU)
# ============================================

channel_type: feishu
enabled: false

# 飞书应用凭证（从 https://open.feishu.cn 获取）
app_id: "cli_..."
app_secret: "..."

# 事件订阅
encrypt_key: ""
verification_token: ""

# 消息处理选项
mention_only: true
allow_groups:
  - "oc_..."    # 允许响应的群聊 ID
