# ============================================
# 消息渠道配置示例 — 飞书（规划中，当前通过环境变量配置）
# ============================================
# 当前方式：设置 FEISHU_APP_ID / FEISHU_APP_SECRET 环境变量
# YAML 配置将在 M3.6l 渠道配置热加载中实现
# ============================================

channel_type: feishu
enabled: false

# 飞书应用凭证（从 https://open.feishu.cn 获取）
app_id: "cli_..."
app_secret: "..."

# 事件订阅
encrypt_key: ""
verification_token: ""

# 消息处理选项
mention_only: true
allow_groups:
  - "oc_..."    # 允许响应的群聊 ID
