# ============================================
# 消息渠道配置示例 — 微信（规划中，当前通过环境变量配置）
# ============================================
# 当前方式：
#   个人微信：设置 WECHAT_SESSION_KEY 环境变量
#   企业微信：设置 WECOM_BOT_KEY 环境变量
# YAML 配置将在 M3.6l 渠道配置热加载中实现
# ============================================

channel_type: wechat
enabled: false

# 子类型：personal（个人微信）| enterprise（企业微信）
sub_type: personal

# 个人微信 — iLink Bot session_key
session_key: "..."

# 企业微信 — Webhook Bot Key
# bot_key: "..."
# webhook_url: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..."

# 消息处理选项
mention_only: false
